{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Dark Menace Kult – Grimdark Miniatures | {% endblock %}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Grimdark miniatures, resin prints and signature painting by Lamaxmenace.">

    {# Tailwind CDN – Ok for MVP #}
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#0b0b0b',
                        surface: '#121212',
                        accent: '#8b0000',
                        bone: '#d6d1c4'
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background: radial-gradient(circle at top, #111 0%, #000 60%);
        }
    </style>

    {% block structured_data %}
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Person",
                "name": "Lamaxmenace",
                "alternateName": "The Cult of the Dark Menace",
                "jobTitle": "Grimdark Miniature Artist",
                "url": "https://darkmenacekult.com",
                "sameAs": [
                    "https://instagram.com/lamaxmenace",
                    "https://www.tiktok.com/@lamaxmenace",
                    "https://www.youtube.com/@lamaxmenace"
                ]
            }
        </script>
    {% endblock %}

    {% block stylesheets %}{% endblock %}
</head>

<body class="text-bone font-serif tracking-wide">
{% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('admin') }}" class="text-sm uppercase tracking-widest font-bold">
        > Back-office
    </a>
{% endif %}
<!-- HEADER -->
<header class="border-b border-white/10 bg-black/70 backdrop-blur">
    <div class="max-w-6xl mx-auto px-6 py-6 flex justify-between items-center">
        <a href="{{ path('home') }}" class="text-xl uppercase tracking-widest font-bold">
            The Cult of the Dark Menace
        </a>
        <nav class="flex items-center space-x-6 text-sm uppercase">

            <!-- Desktop menu -->
            <div class="hidden md:flex items-center space-x-6">
                <a href="{{ path('product_index') }}" class="hover:text-accent transition">Boutique</a>
                <a href="/gallery" class="hover:text-accent transition">Galerie</a>
                <a href="/order" class="hover:text-accent transition">Commander</a>
            </div>

            <!-- Icons -->
            <div class="flex items-center space-x-4">

                {# Panier avec badge #}
                <!-- Icons -->
                <a href="{{ path('cart_index') }}" class="relative hover:text-accent transition" title="Panier">
                    Panier
                    {% set cartCount = cartService.getItemsCount() %}
                    {% if cartCount > 0 %}
                        <span class="absolute -top-2 -right-3 bg-accent text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
                            {{ cartCount }}
                        </span>
                    {% endif %}
                </a>

                {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                    <a href="{{ path('account_index') }}"
                       class="hidden md:inline-flex hover:text-accent transition"
                       title="Compte">
                        👤
                    </a>

                    <a href="{{ path('logout') }}"
                       class="hidden md:inline-flex hover:text-accent transition"
                       title="Déconnexion">
                        ➜]
                    </a>
                {% else %}
                    <a href="{{ path('login') }}"
                       class="hidden md:inline-flex hover:text-accent transition"
                       title="Connexion">
                        Connexion
                    </a>
                {% endif %}


                <!-- Burger (mobile) -->
                <button
                    class="md:hidden text-xl"
                    onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
                >
                    ☰
                </button>
            </div>
        </nav>
    </div>
</header>

<div id="mobile-menu" class="hidden md:hidden bg-black border-b border-white/10">
    <div class="px-6 py-4 space-y-4 uppercase text-sm">
        <a href="{{ path('product_index') }}" class="block hover:text-accent">Boutique</a>
        <a href="/gallery" class="block hover:text-accent">Galerie</a>
        <a href="/order" class="block hover:text-accent">Commander</a>

        <hr class="border-white/10">

        {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
            <a href="{{ path('account_index') }}" class="block hover:text-accent">Mon compte</a>
            <a href="{{ path('logout') }}" class="block hover:text-accent">Déconnexion</a>
        {% else %}
            <a href="{{ path('login') }}" class="block hover:text-accent">Connexion</a>
        {% endif %}
    </div>
</div>


<!-- MAIN -->
<main class="min-h-screen">
    {% block body %}{% endblock %}
</main>

<!-- FOOTER -->
<footer class="border-t border-white/10 mt-24 bg-black/80">
    <div class="max-w-6xl mx-auto px-6 py-10 text-sm text-white/50">
        <div class="flex flex-col md:flex-row justify-between gap-6">
            <div>
                <p class="uppercase tracking-widest text-white">LMM Painting</p>
                <p class="mt-2">Grimdark miniatures & resin prints</p>
            </div>
            <div class="flex items-center space-x-4">
                <a href="https://www.instagram.com/lamaxmenace/" target="_blank" class="hover:text-accent" title="Instagram">📸</a>
                <a href="https://www.tiktok.com/@lamaxmenace" target="_blank" class="hover:text-accent" title="TikTok">🎥</a>
                <a href="https://www.youtube.com/@lamaxmenacepainting" target="_blank" class="hover:text-accent" title="YouTube">▶️</a>
                <span class="mx-2 text-white/20">|</span>
                <a href="/legal/mentions" class="hover:text-white">Mentions légales</a>
                <a href="/legal/cgv" class="hover:text-white">CGV</a>
            </div>
        </div>
        <p class="mt-6 text-xs">© {{ "now"|date("Y") }} – All pieces are handmade & unique.</p>
    </div>
</footer>

{% block javascripts %}{% endblock %}
</body>
</html>
