{# templates/home/home.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Home{% endblock %}

{% block body %}
    <!-- HERO -->
    <section class="relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('/assets/hero-grimdark.jpg')] bg-cover bg-center opacity-20"></div>
        <div class="relative max-w-6xl mx-auto px-6 py-32 text-center">
            <h1 class="text-4xl md:text-6xl font-bold uppercase tracking-widest">
                The Dark Menace Kult
            </h1>
            <p class="mt-6 text-lg md:text-xl text-white/70 max-w-2xl mx-auto">
                Figurines grimdark, impressions résine et peintures signature.<br/>
                Chaque pièce est une offrande à l’obscurité.
            </p>
            <div class="mt-10 flex justify-center gap-6">
                <a href="/gallery" class="px-8 py-4 border border-bone uppercase tracking-widest hover:bg-bone hover:text-black transition">
                    Voir la galerie
                </a>
                <a href="/order" class="px-8 py-4 bg-accent uppercase tracking-widest hover:bg-red-900 transition">
                    Commander une pièce
                </a>
            </div>
        </div>
    </section>


    <!-- MANIFESTE -->
    <section class="max-w-5xl mx-auto px-6 py-24 text-center">
        <h2 class="text-3xl uppercase tracking-widest">Manifeste</h2>
        <p class="mt-8 text-white/70 leading-relaxed">
            The Dark Menace Kult n’est pas une boutique.
            C’est un atelier.
            <br><br>
            Toutes les pièces sont conçues, imprimées et peintes par <strong>Lamaxmenace</strong>.
            <br><br>
            Ici, chaque figurine est imprimée en résine sous licence officielle,
            puis peinte à la main dans un style grimdark assumé : textures sales,
            contrastes violents, atmosphères oppressantes.
            <br><br>
            Aucune production industrielle.
            Aucun rendu aseptisé.
            Chaque pièce est unique.
        </p>
    </section>


    <!-- SERVICES -->
    <section class="bg-surface py-24">
        <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-3 gap-12 text-center">
            <div>
                <h3 class="uppercase tracking-widest">Impression Résine</h3>
                <p class="mt-4 text-white/60">
                    Modèles sélectionnés, impressions haute précision,
                    résine lavable premium.
                </p>
            </div>
            <div>
                <h3 class="uppercase tracking-widest">Peinture Signature</h3>
                <p class="mt-4 text-white/60">
                    Sous-couche, couleurs principales,
                    enamels, huiles et vernis.
                </p>
            </div>
            <div>
                <h3 class="uppercase tracking-widest">Pièces Display</h3>
                <p class="mt-4 text-white/60">
                    Dioramas, scènes, figures de collection
                    prêtes à exposer.
                </p>
            </div>
        </div>
    </section>


    <!-- PROCESS -->
    <section class="max-w-6xl mx-auto px-6 py-24">
        <h2 class="text-3xl uppercase tracking-widest text-center">Process</h2>
        <div class="mt-16 grid md:grid-cols-4 gap-12 text-center">
            <div>
                <span class="text-accent text-3xl">01</span>
                <p class="mt-4">Sélection du modèle</p>
            </div>
            <div>
                <span class="text-accent text-3xl">02</span>
                <p class="mt-4">Impression & préparation</p>
            </div>
            <div>
                <span class="text-accent text-3xl">03</span>
                <p class="mt-4">Peinture grimdark</p>
            </div>
            <div>
                <span class="text-accent text-3xl">04</span>
                <p class="mt-4">Vernis & expédition</p>
            </div>
        </div>
    </section>


    <!-- CTA FINAL -->
    <section class="bg-black py-32 text-center">
        <h2 class="text-3xl uppercase tracking-widest">Entrer dans le culte</h2>
        <p class="mt-6 text-white/60">
            Pièces limitées. Créneaux restreints.
        </p>
        <a href="/order" class="inline-block mt-10 px-10 py-4 border border-accent uppercase tracking-widest hover:bg-accent transition">
            Faire une demande
        </a>
    </section>
{% endblock %}
