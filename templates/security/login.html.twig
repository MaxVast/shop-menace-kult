{# templates/security/login.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Connexion – The Dark Menace Kult{% endblock %}

{% block body %}
    <section class="min-h-screen flex items-center justify-center bg-black text-gray-100">
        <div class="w-full max-w-md bg-zinc-900 border border-zinc-800 rounded-xl p-8 shadow-xl">

            <h1 class="text-3xl font-bold text-center mb-6 uppercase tracking-widest">
                Entrer dans le culte
            </h1>

            {% if error %}
                <div class="bg-red-900/40 border border-red-800 text-red-200 p-3 rounded mb-4 text-sm">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="space-y-5">

                <div>
                    <label for="email" class="block text-sm text-gray-400 mb-1">
                        Email
                    </label>
                    <input type="email"
                           value="{{ last_username }}"
                           name="email"
                           id="email"
                           autocomplete="email"
                           required
                           class="w-full bg-black border border-zinc-700 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-800">
                </div>

                <div>
                    <label for="password" class="block text-sm text-gray-400 mb-1">
                        Mot de passe
                    </label>
                    <input type="password"
                           name="password"
                           id="password"
                           autocomplete="current-password"
                           required
                           class="w-full bg-black border border-zinc-700 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-800">
                </div>

                <input type="hidden" name="_csrf_token"
                       value="{{ csrf_token('authenticate') }}">

                <button type="submit"
                        class="w-full bg-red-900 hover:bg-red-800 transition rounded py-2 font-semibold tracking-wide">
                    Entrer
                </button>

            </form>

            <p class="text-center text-sm text-gray-500 mt-6">
                Pas encore initié ?
                <a href="{{ path('register') }}" class="text-red-700 hover:underline">
                    Créer un compte
                </a>
            </p>

        </div>
    </section>
{% endblock %}
