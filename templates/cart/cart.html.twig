{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Panier{% endblock %}

{% block body %}
    <section class="max-w-6xl mx-auto px-6 py-4">
        <p class="text-white/60 mx-auto">
            > <a class="hover:text-accent transition" href="{{ path('home')}}">Home</a>
        </p>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-16">

        <header class="mb-14 text-center">
            <h1 class="text-3xl md:text-4xl uppercase tracking-widest mb-4">
                Panier
            </h1>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            {% for item in cart %}
                <div class="border-b border-white/10 py-6 flex justify-between items-start">

                    <!-- INFOS PRODUIT -->
                    <div>
                        <strong class="block mb-1">{{ item.name }}</strong>

                        <div class="flex items-center gap-4 mt-2">
                            <form method="post" action="{{ path('cart_decrease', {id: item.productId}) }}">
                                <button class="px-3 py-1 bg-gray-800 hover:bg-gray-700">−</button>
                            </form>

                            <span>{{ item.quantity }}</span>

                            <form method="post" action="{{ path('cart_increase', {id: item.productId}) }}">
                                <button class="px-3 py-1 bg-gray-800 hover:bg-gray-700">+</button>
                            </form>

                            {% if item.quantity == 1 %}
                                <form method="post" action="{{ path('cart_remove', {id: item.productId}) }}">
                                    <button class="ml-4 text-red-600 hover:text-red-400">
                                        Supprimer
                                    </button>
                                </form>
                            {% endif %}
                        </div>


                        <p class="text-sm text-white/70">
                            Prix : {{ item.price | number_format(2, ',', ' ') }} €
                        </p>

                        {% if item.paintingOption %}
                            <p class="text-sm text-white/70">
                                Option : {{ item.paintingOption.name }}
                                (+{{ (item.paintingOption.price / 100)|number_format(2, ',', ' ') }} €)
                            </p>
                        {% endif %}
                    </div>

                    <!-- ACTIONS -->
                    <form method="post"
                          action="{{ path('cart_remove', { id: item.productId }) }}"
                          onsubmit="return confirm('Supprimer cet article du panier ?');">

                        <input type="hidden" name="_token"
                               value="{{ csrf_token('remove_cart_item_' ~ item.productId) }}">

                        <button
                            class="text-red-500 hover:text-red-700 text-sm uppercase tracking-widest transition">
                            Supprimer
                        </button>
                    </form>

                </div>
            {% else %}
                <p>Votre panier est vide</p>
            {% endfor %}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-8">
            <p class="text-xl">
                Total : {{ total | number_format(2, ',', ' ') }} €
            </p>
        </div>

    </section>
{% endblock %}
