{% extends 'user/account/layout.html.twig' %}

{% block account_content %}
    <h1 class="text-2xl uppercase tracking-widest mb-6">
        Mes commandes
    </h1>

    {% if orders is empty %}
        <p class="text-gray-400">
            Aucune commande pour le moment.
        </p>
    {% else %}
        <div class="space-y-4">
            {% for order in orders %}
                <div class="border border-zinc-800 rounded-lg p-4 flex justify-between items-center">
                    <div>
                        <p class="uppercase text-sm tracking-widest">
                            Commande #{{ order.id }}
                        </p>
                        <p class="text-gray-400 text-sm">
                            {{ order.createdAt|date('d/m/Y') }} – {{ order.status|upper }}
                        </p>
                    </div>

                    <div class="text-right">
                        <p class="font-semibold">
                            {{ (order.total / 100)|number_format(2, ',', ' ') }} €
                        </p>
                        <a href="{{ path('account_order_show', {id: order.id}) }}"
                           class="text-sm text-red-700 hover:underline">
                            Voir le détail
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
