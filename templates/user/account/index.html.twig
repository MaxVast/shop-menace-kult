{% extends 'user/account/layout.html.twig' %}

{% block account_content %}
    <h1 class="text-2xl uppercase tracking-widest mb-6">
        Informations du compte
    </h1>

    <div class="space-y-4 text-sm">
        <div>
            <span class="text-gray-400">Pseudo :</span>
            <strong>{{ app.user.username }}</strong>
        </div>

        <div>
            <span class="text-gray-400">Email :</span>
            <strong>{{ app.user.email }}</strong>
        </div>

        <div class="border-t border-zinc-800 pt-4 mt-6">
            <h2 class="uppercase text-sm tracking-widest text-gray-400 mb-3">
                Adresse
            </h2>

            <p>
                {{ app.user.address.street }}<br>
                {{ app.user.address.postalCode }} {{ app.user.address.city }}<br>
                {{ app.user.address.country }}
            </p>
        </div>

        <a href="{{ path('account_edit') }}"
           class="inline-block mt-6 bg-red-900 hover:bg-red-800 transition px-4 py-2 rounded text-sm uppercase tracking-wide">
            Modifier mes informations
        </a>
    </div>
{% endblock %}
